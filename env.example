PTUBE_MANIFEST="PornTube Manifest URL"
STREMIO_USER="user@email.com"
STREMIO_PASS="password"
PORT=9000
RD_TOKEN="your_real_debrid_token_here"
# Optional: pin Real-Debrid CDN after /unrestrict/link (short name ok: nyk7-4).
# Without this, RD picks the nearest CDN node for you. Find the fastest from your server:
#   python scripts/realdebrid_cdn_speedtest.py
# RD_PREFERRED_CDN=45.download.real-debrid.cloud
# Optional: background scan to auto-pick the fastest Real-Debrid CDN host on startup.
# If RD_PREFERRED_CDN is set, the scan is skipped. Default: on when not pinned.
# RD_AUTO_SCAN=1
# Seconds to download per CDN host during the scan:
# RD_SCAN_SECONDS=6.0
# Parallel probes:
# RD_SCAN_WORKERS=8
# Optional hosts list (short names ok: nyk7-4, den1-4). Empty uses built-in list:
# RD_SCAN_HOSTS=
# How many top results are considered (prints/debug; winner is still best):
# RD_SCAN_TOP=20
# Probe connect timeout (seconds):
# RD_SCAN_CONNECT_TIMEOUT_SEC=8
# Re-scan TTL cache (seconds; set 0 to always re-scan):
# RD_SCAN_CACHE_TTL_SEC=86400
STASHDB_API_KEY="your_stashdb_api_key_here"
# StashDB scene cache (file path; parent dirs are created automatically).
# Docker Compose defaults to /app/cache/scenes.json with ./cache bind-mounted.
# CACHE_FILE=cache/scenes.json
# How often (minutes) to re-poll Stremio for new library items. 0 = disabled.
LIBRARY_REFRESH_MINUTES=15
# Proxy HereSphere thumbnails through /thumb/<id> (parallel fetch + startup prefetch).
# THUMB_PROXY=1
# Parallel upstream fetches for thumbnail prefetch:
# THUMB_WORKERS=8
# Convert webp thumbnails to jpeg when proxying (webp won't render on some headsets):
# THUMB_CONVERT_WEBP=1
# Cache proxied thumbnails on disk (needs THUMB_PROXY). Unset = no disk cache.
# THUMB_CACHE_DIR=cache/thumbs
# Delete cached thumbnails not accessed for this many days (0 = keep forever):
# THUMB_CACHE_TTL_DAYS=30
DEBUG_MODE=False